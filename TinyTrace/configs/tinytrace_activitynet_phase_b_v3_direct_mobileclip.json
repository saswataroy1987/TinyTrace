{
  "schema_version": "tinytrace.phase-b-v3.direct-mobileclip.config.v1",
  "feature_dim": 1024,
  "patch_tokens": 64,
  "max_event_frames": 8,
  "visual_tokens": 16,
  "visual_heads": 8,
  "visual_dropout": 0.1,
  "flan_model_name": "google/flan-t5-small",
  "flan_revision": "main",
  "flan_local_files_only": true,
  "instruction": "Describe the event shown in the video.",
  "caption_max_tokens": 64,
  "generation_max_tokens": 64,
  "generation_min_tokens": 3,
  "repetition_penalty": 1.1,
  "no_repeat_ngram_size": 3,
  "train_flan_encoder_layers": 1,
  "train_flan_decoder_layers": 1,
  "use_stage1_temporal_context": false,
  "temporal_context_tokens": 2,
  "stage1_context_dim": 256,
  "train_stage1_temporal_layers": 0
}
