{
  "schema_version": "tinytrace.final-causal.config.v1",
  "feature_dim": 1024,
  "patch_tokens": 64,
  "max_video_frames": 32,
  "visual_slots_per_frame": 8,
  "time_tokens_per_frame": 6,
  "visual_heads": 8,
  "visual_dropout": 0.1,
  "time_bins": 100,
  "flan_model_name": "google/flan-t5-small",
  "flan_revision": "main",
  "flan_local_files_only": true,
  "instruction": "Describe the chronological events shown in the video.",
  "target_max_tokens": 1024,
  "generation_max_tokens": 1024,
  "generation_min_tokens": 4,
  "repetition_penalty": 1.1,
  "no_repeat_ngram_size": 3,
  "train_flan_encoder_layers": 1,
  "train_full_flan_decoder": true
}
