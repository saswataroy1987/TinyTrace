{
  "train_script": "TinyTrace/scripts/train_tinytrace.py",
  "model_config": "TinyTrace/configs/tinytrace_qvhighlights_phase_a_v3.json",
  "train_dataset_json": "final_qvhighlights_tinytrace/annotations/tinytrace_phase_a_v3_train.json",
  "val_dataset_json": "final_qvhighlights_tinytrace/annotations/tinytrace_phase_a_v3_val.json",
  "output_dir": "TinyTrace/outputs-qvh-phase-a-v3-full",
  "frame_cache_dir": "TinyTrace/.cache/frames_qvh-phase-a-v3-128-uint8",
  "visual_feature_cache_dir": "TinyTrace/.cache/mobileclip_qvh-phase-a-v3-128-fp16",
  "require_visual_feature_cache": true,
  "device": "cuda",
  "epochs": 15,
  "batch_size": 1,
  "dataset_size": 128,
  "lr": 0.0001,
  "weight_decay": 0.01,
  "gradient_clip": 5.0,
  "warmup_ratio": 0.05,
  "min_lr_ratio": 0.1,
  "amp": "auto",
  "accumulation_steps": 8,
  "early_stopping_patience": 3,
  "early_stopping_min_delta": 0.0,
  "early_stopping_min_epochs": 5,
  "monitor": "qvh_mean_score_proxy_Good_mAP",
  "monitor_mode": "max",
  "save_every": 1,
  "checkpoint_keep": 3,
  "prediction_every": 1,
  "prediction_samples": 8,
  "metrics_every": 1,
  "num_workers": 2,
  "log_every": 50,
  "max_steps_per_epoch": 0,
  "max_optimizer_steps": 0,
  "stage2_start_epoch": 0,
  "stage2_visual_lr_scale": 0.05,
  "stage2_unfreeze_strategy": "conv_exp",
  "seed": 7,
  "deterministic": true,
  "allow_random_frames": false,
  "resume": ""
}
